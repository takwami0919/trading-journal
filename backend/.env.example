# Copy this file to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/trading_journal

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me

# Alpaca paper trading (never live) — get keys from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
